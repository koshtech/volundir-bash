#!/usr/bin/env bash

set -euo pipefail

KOSHTECH_HOME=$(dirname $(dirname $0))
KOSHTECH_CONFIG="${KOSHTECH_HOME}/config"
INGOTS_ROOT="${KOSHTECH_HOME}/ingots"

VOLUNDIR_ROOT="${KOSHTECH_HOME}/volundir"
VOLUNDIR_CONFIG_PATH="${VOLUNDIR_ROOT}/config"
VOLUNDIR_INGOTS_PATH="${VOLUNDIR_ROOT}/ingots"
VOLUNDIR_LOCALES_PATH="${VOLUNDIR_ROOT}/locales"
VOLUNDIR_DEBUG="false"

SHELL_ROOT="${VOLUNDIR_ROOT}/shell"
RUBY_ROOT="${VOLUNDIR_ROOT}/ruby"
JS_ROOT="${VOLUNDIR_ROOT}/javascript"

APPS_ROOT="${VOLUNDIR_ROOT}/apps"
ASSETS_ROOT="${VOLUNDIR_ROOT}/assets"

export KOSHTECH_HOME\
       KOSHTECH_CONFIG\
       INGOTS_ROOT\
       VOLUNDIR_ROOT\
       VOLUNDIR_CONFIG_PATH\
       VOLUNDIR_INGOTS_PATH\
       VOLUNDIR_LOCALES_PATH\
       VOLUNDIR_DEBUG\
       SHELL_ROOT\
       RUBY_ROOT\
       JS_ROOT\
       ASSETS_ROOT\
       APPS_ROOT

if [[ "$VOLUNDIR_DEBUG" == "true" ]]; then
  echo "KOSHTECH_HOME : $KOSHTECH_HOME"
  echo "KOSHTECH_CONFIG : $KOSHTECH_CONFIG"
  echo "INGOTS_ROOT : $INGOTS_ROOT"
  echo "VOLUNDIR_ROOT : $VOLUNDIR_ROOT"
  echo "VOLUNDIR_CONFIG_PATH : $VOLUNDIR_CONFIG_PATH"
  echo "VOLUNDIR_INGOTS_PATH : $VOLUNDIR_INGOTS_PATH"
  echo "VOLUNDIR_DEBUG : $VOLUNDIR_DEBUG"
  echo "SHELL_ROOT : $SHELL_ROOT"
  echo "RUBY_ROOT : $RUBY_ROOT"
  echo "JS_ROOT : JS_ROOT$"
  echo "ASSETS_ROOT : ASSETS_ROOT$"
  echo "APPS_ROOT : $APPS_ROOT"
fi

"${RUBY_ROOT}/bin/volundir_ruby.rb" $@
